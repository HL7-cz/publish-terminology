<https://hl7.cz/terminology/ValueSet/eHDSIRouteofAdministration> a fhir:ValueSet ;
  fhir:nodeRole fhir:treeRoot ;
  fhir:Resource.id [ fhir:value "eHDSIRouteofAdministration"] ;
