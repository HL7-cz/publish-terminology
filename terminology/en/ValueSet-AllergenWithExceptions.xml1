  <description value="The Value Set is used for coding s specific allergen or other agent/substance (drug, food, chemical agent, etc.) to which the patient has an adverse reaction propensity.&#xA;It is defined as the union of:&#xA;(a) eHDSIAllergenNoDrug&#xA;(b) DLP_lecivePripravky&#xA;(c) DLP_ATC&#xA;(d) eHDSIAbsentOrUnknownAllergy&#xA;(e) eHDSIExceptionalValue"/>
  <jurisdiction>
    <coding>
      <system value="urn:iso:std:iso:3166"/>
      <code value="CZ"/>
      <display value="Czechia"/>
    </coding>
  </jurisdiction>
