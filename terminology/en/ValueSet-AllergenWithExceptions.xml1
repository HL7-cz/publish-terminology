    <include>
      <valueSet value="https://ncez.mzcr.cz/terminology/ValueSet/eHDSIAbsentOrUnknownAllergy"/>
    </include>
    <include>
      <valueSet value="https://ncez.mzcr.cz/terminology/ValueSet/eHDSIExceptionalValue"/>
    </include>
  </compose>
</ValueSet>