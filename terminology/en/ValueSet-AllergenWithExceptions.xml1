  <compose>
    <include>
      <valueSet value="https://ncez.mzcr.cz/terminology/ValueSet/eHDSIAllergenNoDrug"/>
    </include>
    <include>
      <valueSet value="https://sukl.cz/terminology/ValueSet/dlp-lecivepripravky"/>
    </include>
    <include>
      <valueSet value="https://sukl.cz/terminology/ValueSet/dlp-atc"/>
