  fhir:ValueSet.experimental [ fhir:value "false"^^xsd:boolean] ;
  fhir:ValueSet.date [ fhir:value "2025-11-01"^^xsd:date] ;
  fhir:ValueSet.publisher [ fhir:value "HL7 Czech Republic"] ;
