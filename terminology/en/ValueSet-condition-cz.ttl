       fhir:ContactPoint.value [ fhir:value "https://www.hl7.cz/" ]
     ]
  ] ;
  fhir:ValueSet.description [ fhir:value "Condition value set includes selected codes from national and recommended EU code systems for health conditions (MKN-10, SNOMED CT and Orphacodes)."] ;
