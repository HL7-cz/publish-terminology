    <display value="matka"/>
    <definition value="Žena, která zplodila, porodila nebo vychovala a pečuje o dotčenou osobu (dítě)."/>
  </concept>
  <concept>
    <code value="MTHINLAW"/>
    <display value="tchýně"/>
