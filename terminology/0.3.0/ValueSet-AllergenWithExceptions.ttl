  fhir:DomainResource.text [
     fhir:Narrative.status [ fhir:value "generated" ] ;
     fhir:Narrative.div "<div xml:lang=\"cs\" xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"cs\"><p class=\"res-header-id\"><b>Generated Narrative: ValueSet AllergenWithExceptions</b></p><a name=\"AllergenWithExceptions\"> </a><a name=\"hcAllergenWithExceptions\"> </a><div style=\"display: inline-block; background-color: #d9e0e7; padding: 6px; margin: 4px; border: 1px solid #8da1b4; border-radius: 5px; line-height: 60%\"><p style=\"margin-bottom: 0px\">Language: cs</p></div><p>This value set includes codes based on the following rules:</p><ul><li>Import all the codes that are contained in <a href=\"ValueSet-eHDSIAllergenNoDrug.html\">eHDSI Allergen No Drug</a></li><li>Import all the codes that are contained in <a href=\"ValueSet-dlp-lecivepripravky.html\">Léčivé přípravky</a></li><li>Import all the codes that are contained in <a href=\"ValueSet-dlp-atc.html\">Český číselník ATC skupin</a></li><li>Import all the codes that are contained in <a href=\"ValueSet-eHDSIAbsentOrUnknownAllergy.html\">eHDSI Absent Or Unknown Allergy</a></li><li>Import all the codes that are contained in <a href=\"ValueSet-eHDSIExceptionalValue.html\">eHDSI Exceptional Value</a></li></ul></div>"
  ] ;
