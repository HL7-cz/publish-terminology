                    <button data-clipboard-text="{&quot;system&quot;: &quot;http://terminology.hl7.org/CodeSystem/v3-RoleCode&quot;, &quot;version&quot;: &quot;3.0.0&quot;, &quot;code&quot;: &quot;NBOR&quot;, &quot;display&quot;: &quot;soused/sousedka&quot;}" title="Click to Copy as Coding" class="btn-copy"> </button>
